# NECTO / CMake build outputs and the clangd index: regenerated on every build.
InitialTesting/.cache/
InitialTesting/compile_commands.json
# Build folders, one per NECTO build configuration (build-MM4,
# "build-Default Configuration", ...). Only build-MM4/generated is kept: the
# LVGL Designer screen code (from main_screen.mscr), which tools/ui-preview
# compiles.
InitialTesting/build-*/
!InitialTesting/build-MM4/
InitialTesting/build-MM4/*
!InitialTesting/build-MM4/generated/

# Python bytecode.
__pycache__/

# Simulator test screenshots.
simulator/tests/shots/
